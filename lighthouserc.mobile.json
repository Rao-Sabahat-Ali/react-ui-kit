{
  "ci": {
    "collect": {
      "startServerCommand": "npx vite preview --config vite.docs.config.ts --port 4176 --strictPort",
      "startServerReadyPattern": "4176",
      "url": [
        "http://localhost:4176/?route=home",
        "http://localhost:4176/?route=analytics-dashboard#/blueprints/analytics-dashboard",
        "http://localhost:4176/?route=admin-list-detail#/blueprints/admin-list-detail",
        "http://localhost:4176/?route=board#/blueprints/board",
        "http://localhost:4176/?route=overview-index#/blueprints/overview-index",
        "http://localhost:4176/?route=settings#/blueprints/settings",
        "http://localhost:4176/?route=checkout#/blueprints/checkout",
        "http://localhost:4176/?route=sign-in#/blueprints/sign-in",
        "http://localhost:4176/?route=article-detail#/blueprints/article-detail"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "warn",
          {
            "minScore": 0.9,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.9,
            "aggregationMethod": "median-run"
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/mobile"
    }
  }
}
