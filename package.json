{
  "name": "@sabahat/react-ui-kit",
  "version": "2.0.0",
  "description": "React 19 + Bootstrap 5.3 component library implementing the personal design system (specs served by design-system-mcp).",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "workspaces": [
    "packages/*"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/types/vite/index.d.ts",
      "import": "./dist/vite.js"
    },
    "./styles.css": "./dist/styles.css",
    "./styles/*": "./dist/styles/*",
    "./scss/*": "./src/styles/*"
  },
  "files": [
    "dist",
    "src/styles",
    "src/fonts",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "vite --config vite.docs.config.ts",
    "build": "npm run build:lib && npm run build:types",
    "build:lib": "vite build",
    "build:types": "tsc -p tsconfig.build.json && node scripts/clean-types.mjs",
    "build:docs": "vite build --config vite.docs.config.ts",
    "preview:docs": "vite preview --config vite.docs.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && node scripts/check-bundle.mjs && npm run check:3d",
    "prepare": "npm run build",
    "lint": "eslint .",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "register": "node scripts/register-components.mjs",
    "create-app": "node scripts/create-app.mjs",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build && node scripts/check-bundle.mjs",
    "build:3d": "npm run build -w @sabahat/react-ui-kit-3d",
    "check:3d": "npm run typecheck -w @sabahat/react-ui-kit-3d && npm run build:3d && npm run check:bundle -w @sabahat/react-ui-kit-3d"
  },
  "peerDependencies": {
    "bootstrap": "^5.3.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "bootstrap": "5.3.8",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sass": "1.106.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "peerDependenciesMeta": {
    "bootstrap": {
      "optional": true
    }
  },
  "author": "Rao Sabahat Ali <raosabahat@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rao-Sabahat-Ali/react-ui-kit.git"
  },
  "homepage": "https://react-ui-kit-docs.vercel.app",
  "bugs": {
    "url": "https://github.com/Rao-Sabahat-Ali/react-ui-kit/issues"
  },
  "keywords": [
    "react",
    "react-19",
    "bootstrap",
    "ui-kit",
    "components",
    "design-system",
    "dark-mode",
    "accessible",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
